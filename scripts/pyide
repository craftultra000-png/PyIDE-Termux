#!/data/data/com.termux/files/usr/bin/bash
# PyIDE Termux launcher — starts the local server once and opens it in Android.
set -Eeuo pipefail

APP_DIR="${PYIDE_HOME:-$HOME/PyIDE-Termux}"
HOST="127.0.0.1"
PORT="${PYIDE_PORT:-8080}"
URL="http://${HOST}:${PORT}"
PID_FILE="${PYIDE_PID_FILE:-$HOME/.pyide-termux.pid}"
LOG_FILE="${PYIDE_LOG_FILE:-$HOME/.pyide-termux.log}"

usage() {
  cat <<'EOF'
Usage: pyide [--status|--stop]

Starts PyIDE Termux at http://127.0.0.1:8080 and opens it in Android.
EOF
}

server_ready() {
  curl --fail --silent --max-time 1 "$URL" >/dev/null 2>&1
}

stop_server() {
  if [[ ! -f "$PID_FILE" ]]; then
    printf 'PyIDE is not running.\n'
    return 0
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    printf 'PyIDE stopped.\n'
  else
    printf 'No active PyIDE process was found.\n'
  fi
  rm -f "$PID_FILE"
}

open_browser() {
  if command -v termux-open-url >/dev/null 2>&1; then
    termux-open-url "$URL"
  elif command -v am >/dev/null 2>&1; then
    am start -a android.intent.action.VIEW -d "$URL" >/dev/null 2>&1 || true
  else
    printf 'Open this address in your browser: %s\n' "$URL"
  fi
}

case "${1:-}" in
  --stop) stop_server; exit 0 ;;
  --status)
    if server_ready; then printf 'PyIDE is running at %s\n' "$URL"; else printf 'PyIDE is not running.\n'; fi
    exit 0
    ;;
  --help|-h) usage; exit 0 ;;
  '') ;;
  *) usage; exit 2 ;;
esac

if [[ ! -f "$APP_DIR/server.py" ]]; then
  printf 'PyIDE installation was not found at: %s\n' "$APP_DIR" >&2
  printf 'Reinstall it with: git clone https://github.com/craftultra000-png/PyIDE-Termux.git "$HOME/PyIDE-Termux"\n' >&2
  exit 1
fi

if ! command -v python >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  printf 'Missing Termux dependencies. Run: pkg install python curl\n' >&2
  exit 1
fi

if ! server_ready; then
  printf 'Starting PyIDE…\n'
  (
    cd "$APP_DIR"
    nohup python server.py >>"$LOG_FILE" 2>&1 &
    printf '%s\n' "$!" >"$PID_FILE"
  )

  for _ in $(seq 1 30); do
    if server_ready; then break; fi
    sleep 0.2
  done
fi

if ! server_ready; then
  printf 'PyIDE did not start. Read the log: %s\n' "$LOG_FILE" >&2
  exit 1
fi

printf 'PyIDE is ready at %s\n' "$URL"
open_browser
