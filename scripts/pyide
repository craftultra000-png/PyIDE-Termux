#!/data/data/com.termux/files/usr/bin/bash
# PyIDE Termux launcher — keeps the local server in the foreground for Ctrl+C.
set -Eeuo pipefail

APP_DIR="${PYIDE_HOME:-$HOME/PyIDE-Termux}"
HOST="127.0.0.1"
PORT="${PYIDE_PORT:-8080}"
URL="http://${HOST}:${PORT}"
SERVER_PID=""
PROC_ROOT="${PYIDE_PROC_ROOT:-/proc}"

usage() {
  cat <<'EOF'
Usage: pyide [--status]

Starts PyIDE Termux at http://127.0.0.1:8080 and stays attached to Termux.
Open the address in your browser manually. Press Ctrl+C to stop the server.
EOF
}

server_ready() {
  curl --fail --silent --max-time 1 "$URL" >/dev/null 2>&1
}

print_url() {
  printf '\033[1;32m%s\033[0m\n' "$URL"
}

find_stale_pyide_pid() {
  local proc pid cmdline cwd
  for proc in "$PROC_ROOT"/[0-9]*; do
    [[ -d "$proc" ]] || continue
    pid="${proc##*/}"
    [[ "$pid" == "$$" ]] && continue
    [[ -r "$proc/cmdline" && -e "$proc/cwd" ]] || continue
    cmdline="$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)"
    cwd="$(readlink -f "$proc/cwd" 2>/dev/null || true)"
    if [[ "$cwd" == "$APP_DIR" && "$cmdline" == *python* && "$cmdline" == *server.py* ]]; then
      printf '%s\n' "$pid"
      return 0
    fi
  done
  return 1
}

release_stale_server() {
  local stale_pid
  stale_pid="$(find_stale_pyide_pid || true)"
  if [[ -z "$stale_pid" ]]; then
    printf 'Port %s is already used by another process.\n' "$PORT" >&2
    printf 'Stop that process first, then run pyide again.\n' >&2
    exit 1
  fi

  printf 'Stopping the previous PyIDE server…\n'
  kill "$stale_pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! server_ready; then return 0; fi
    sleep 0.1
  done
  printf 'The previous PyIDE server did not release port %s.\n' "$PORT" >&2
  exit 1
}

stop_foreground_server() {
  if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    printf '\nStopping PyIDE…\n'
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}

case "${1:-}" in
  --status)
    if server_ready; then printf 'PyIDE is running at %s\n' "$URL"; else printf 'PyIDE is not running.\n'; fi
    exit 0
    ;;
  --help|-h) usage; exit 0 ;;
  '') ;;
  *) usage; exit 2 ;;
esac

if [[ ! -f "$APP_DIR/server.py" ]]; then
  printf 'PyIDE installation was not found at: %s\n' "$APP_DIR" >&2
  printf 'Reinstall it with: git clone https://github.com/craftultra000-png/PyIDE-Termux.git "$HOME/PyIDE-Termux"\n' >&2
  exit 1
fi

if ! command -v python >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  printf 'Missing Termux dependencies. Run: pkg install python curl\n' >&2
  exit 1
fi

if server_ready; then
  release_stale_server
fi

printf 'Starting PyIDE…\n'
(
  cd "$APP_DIR"
  exec python server.py
) &
SERVER_PID="$!"
trap 'stop_foreground_server; exit 130' INT TERM

for _ in $(seq 1 30); do
  if server_ready; then break; fi
  sleep 0.2
done

if ! server_ready; then
  printf 'PyIDE did not start.\n' >&2
  stop_foreground_server
  exit 1
fi

printf 'PyIDE is ready at %s\n' "$URL"
printf 'Open this address manually in your browser:\n'
print_url
printf 'Press Ctrl+C in Termux to stop PyIDE.\n'
wait "$SERVER_PID"
